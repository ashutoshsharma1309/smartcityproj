# UrbanPulse environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# Every value below is read by backend/app/core/config.py (Settings).

# ----------------------------------------------------------------- application
PROJECT_NAME=UrbanPulse
ENVIRONMENT=local              # local | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --------------------------------------------------------------------- logging
LOG_LEVEL=INFO                 # CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_FORMAT=console             # console for local development, json elsewhere

# -------------------------------------------------------------------- database
# POSTGRES_HOST is `localhost` when running the API on the host against the
# Docker database, and `postgres` when the API itself runs in Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=urbanpulse
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ----------------------------------------------------------------------- redis
# Redis caches PostGIS zone/road aggregations per map viewport and, from Phase 2,
# brokers scheduled ingestion jobs. Set REDIS_ENABLED=false to run without it —
# the API still works, just without caching.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_DEFAULT_TTL_SECONDS=300

# ------------------------------------------------------------------------ cors
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------- llm
# Optional. The LLM only rewrites already-computed facts as prose; it never
# produces risk scores, weather values or coordinates. Leave LLM_PROVIDER=none
# and the explanation endpoint reports that it is not configured rather than
# generating filler text.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=700

# ------------------------------------------------------- external data sources
# Public endpoints used by the ingestion service. Open-Meteo and Overpass need
# no API key for development-scale use; respect their published rate limits.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --------------------------------------------------------------- area of interest
# The first target city. Nothing in the code is hardcoded to it.
CITY_NAME=Mumbai
CITY_COUNTRY_CODE=IN
CITY_BBOX=72.775,18.890,72.990,19.280   # min_lon,min_lat,max_lon,max_lat (EPSG:4326)
CITY_CENTER=72.8777,19.0760             # lon,lat
DEFAULT_MAP_ZOOM=10.5

# -------------------------------------------------------------------- frontend
# Read by Next.js at build and run time. Must be reachable from the BROWSER.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional. Set only when the Next.js server cannot reach the API on the URL
# above — under Docker Compose, `localhost` inside the frontend container is the
# frontend itself, so server-side rendering must call the service name instead.
# docker-compose.yml sets this automatically; leave it unset when running
# natively.
# API_BASE_URL_INTERNAL=http://backend:8000
# Raster basemap tiles. The default is the OpenStreetMap standard layer, which
# is acceptable for development use with attribution; switch to your own tile
# server or a commercial provider before any public deployment.
NEXT_PUBLIC_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors
